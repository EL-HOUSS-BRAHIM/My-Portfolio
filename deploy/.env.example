# Deployment selectors, no credentials. Runtime credentials stay in secrets file.
DEPLOY_ENV=staging
PORTFOLIO_DOMAIN=staging.brahim-elhouss.me
PORTFOLIO_IMAGE=ghcr.io/el-houss-brahim/portfolio-staging:REPLACE_WITH_COMMIT_SHA
PORTFOLIO_WORKER_IMAGE=ghcr.io/el-houss-brahim/portfolio-worker-staging:REPLACE_WITH_COMMIT_SHA
PORTFOLIO_SECRETS_FILE=/home/budgetify/portfolio/secrets/staging.env
PORTFOLIO_ALIAS=portfolio-staging-blue
# Unique proxy network, shared with current Lyvora gateway.
