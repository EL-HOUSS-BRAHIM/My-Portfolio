# Copy to web/.env.local for development. Never put real secrets in Git.
SITE_URL=http://localhost:3000
DEPLOY_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Required for public form rate-limit hashing. Generate with openssl rand -hex 32.
RATE_LIMIT_SECRET=
# Keep delivery paused until SMTP is configured; enquiries still save to the dashboard.
# Existing SMTP_ENABLED is accepted too; both flags must agree if both are set.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=smtp.queensmtp.com
SMTP_PORT=465
SMTP_SECURE=true
# Alternative: SMTP_PORT=587 and SMTP_SECURE=false for STARTTLS.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=
# protected readiness, independently generated
HEALTH_TOKEN=
# production mode requires configured Supabase; local demo uses curated repository content
CONTENT_MODE=demo
